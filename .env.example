# Server
PORT=3000

# 允許的前端來源（Vite 預設 http://localhost:5173，多個用逗號分隔）
# 上線後要加上 GitHub Pages 網址，例如：
# CORS_ORIGIN=http://localhost:5173,https://maxyeh666.github.io
CORS_ORIGIN=http://localhost:5173

# PostgreSQL 連線字串
DATABASE_URL=postgres://postgres:postgres@localhost:5432/web3d_proto

# 管理者登入密碼（POST /auth/login 驗證用；正式環境請在 Render 的 Environment Variables 設定）
ADMIN_PASSWORD=change-me

# 簽發 JWT 的密鑰（JWT：登入後發給前端的通行證格式），至少 32 字元
JWT_SECRET=change-me-to-a-long-random-string
